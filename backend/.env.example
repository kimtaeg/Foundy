# LLM 제공자: gemini(기본) | openai. 무료 티어는 입력이 제품 개선에 쓰일 수 있으니 가상 데이터로만 쓴다
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_MAIN=
# AI 상담 질문 범위 판별 모델 (키워드에 안 걸린 질문만). 비우면 gpt-4.1-mini
LLM_MODEL_SCOPE=
# 모델별 단가(USD / 100만 토큰). 비우면 비용이 0으로 기록된다
LLM_PRICE_IN_USD_PER_1M=
LLM_PRICE_OUT_USD_PER_1M=
USD_KRW=1400
# Gemini 생각 깊이: minimal | low | medium | high (비우면 모델 기본값). 낮출수록 빠르다
LLM_THINKING_LEVEL=
JUSO_API_KEY=
BUILDING_API_KEY=
LAW_OC=
KIPRIS_API_KEY=
# 한국부동산원 R-ONE 부동산통계 Open API 인증키 (임대료 비교). https://www.reb.or.kr/r-one 에서 발급
REB_API_KEY=
USE_MOCK=true
FRONTEND_ORIGIN=http://localhost:3000
# Railway PostgreSQL 연결 문자열
# - Railway 배포 서버: 백엔드 서비스 변수에 ${{Postgres.DATABASE_URL}} 참조 (*.railway.internal, 내부망 전용)
# - 로컬 개발: Postgres 서비스의 DATABASE_PUBLIC_URL 값 (*.proxy.rlwy.net). 내부 주소는 로컬에서 접속되지 않는다
DATABASE_URL=
# 로그인 토큰(JWT) 서명 키. 긴 무작위 문자열. 비우면 로컬에서만 임시 키를 쓴다 (Railway에는 반드시 설정)
JWT_SECRET=
# 소셜 로그인(인가 코드 방식). 제공자별 개발자 콘솔에 등록한 값. 비우면 그 제공자 로그인은 503
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 허용하는 로그인 콜백 주소(쉼표 구분). 각 제공자 콘솔에 등록한 주소와 정확히 같아야 한다. 첫 값이 기본값
OAUTH_REDIRECT_URIS=
# 분석 실행: 단일 서버 안에서 동시 실행 수와 전체 제한 시간(초)
ANALYSIS_WORKERS=2
ANALYSIS_TIMEOUT_SECONDS=600
# 외부 API 프로브(scripts/api_probe)용
KAKAO_REST_KEY=
DATA_GO_KR_KEY=
SEOUL_OPENDATA_KEY=

# 법령 임베딩 모델. 키가 있으면 OpenAI(text-embedding-3-large, 768차원으로 줄여 저장), 없으면 LLM_API_KEY 의 Gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
# OpenAI 호환 서비스를 쓸 때만 (비우면 OpenAI)
EMBEDDING_BASE_URL=

# 법령 RAG: 저장된 법령에서 조문을 검색해 점검 근거로 쓴다 (false 면 예전 방식)
LAW_RAG_ENABLED=true
# /internal/* (법령 재수집 예약 작업 등)을 보호하는 토큰. 긴 무작위 문자열. 비우면 내부 API는 항상 거절한다
INTERNAL_TOKEN=
