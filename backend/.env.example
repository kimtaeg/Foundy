# LLM 제공자: gemini(기본) | openai. 무료 티어는 입력이 제품 개선에 쓰일 수 있으니 가상 데이터로만 쓴다
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_MAIN=
# 모델별 단가(USD / 100만 토큰). 비우면 비용이 0으로 기록된다
LLM_PRICE_IN_USD_PER_1M=
LLM_PRICE_OUT_USD_PER_1M=
USD_KRW=1400
# Gemini 생각 깊이: minimal | low | medium | high (비우면 모델 기본값). 낮출수록 빠르다
LLM_THINKING_LEVEL=
JUSO_API_KEY=
BUILDING_API_KEY=
LAW_OC=
KIPRIS_API_KEY=
USE_MOCK=true
FRONTEND_ORIGIN=http://localhost:3000
# Railway PostgreSQL 연결 문자열
# - Railway 배포 서버: 백엔드 서비스 변수에 ${{Postgres.DATABASE_URL}} 참조 (*.railway.internal, 내부망 전용)
# - 로컬 개발: Postgres 서비스의 DATABASE_PUBLIC_URL 값 (*.proxy.rlwy.net). 내부 주소는 로컬에서 접속되지 않는다
DATABASE_URL=
# 주소·건축물 도구 및 외부 API 프로브용 (JUSO/BUILDING 키의 별칭이 아님)
KAKAO_REST_KEY=
DATA_GO_KR_KEY=
SEOUL_OPENDATA_KEY=
