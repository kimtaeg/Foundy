{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-schema.json",
  "title": "PrecheckReport",
  "description": "창업 전 사전 점검 리포트. 프론트·백엔드 공용 약속 — 바꾸면 같은 PR에서 백엔드 생성 코드와 프론트 표시 코드를 함께 수정한다. (초안) 문제 항목은 결과 카드(결론·선택지·추천·기관 전화번호·사용자가 할 일 1개) 형태로 내려간다.",
  "type": "object",
  "required": ["input", "items", "schedule", "disclaimer"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["business_type", "sells_alcohol", "address", "store_name", "open_date"],
      "properties": {
        "business_type": { "type": "string" },
        "sells_alcohol": { "type": "boolean" },
        "address": { "type": "string" },
        "floor": { "type": "string" },
        "store_name": { "type": "string" },
        "open_date": { "type": "string", "format": "date" },
        "menu_text": { "type": "string", "description": "메뉴·광고 문구 점검은 마지막에 구현. 그 전에는 받지 않는다" }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "schedule": {
      "type": "array",
      "items": { "$ref": "#/$defs/scheduleEntry" }
    },
    "disclaimer": {
      "type": "string",
      "description": "\"법률 자문이 아닌 사전 점검\" 안내 문구"
    },
    "usage": {
      "type": "object",
      "description": "점검 1회의 토큰·비용 기록",
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "cost_usd": { "type": "number" }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "stage", "title", "verdict", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "stage": { "enum": ["계약 전", "개업 전", "운영 중"] },
        "title": { "type": "string", "description": "결론 한 줄. 법 용어 대신 결과 중심의 쉬운 말" },
        "verdict": { "enum": ["위반 소지 높음", "위반 소지 낮음·확인 권장", "판단 불가"] },
        "explanation": { "type": "string", "description": "이유 (쉬운 말 한두 문장). 법 조문과 근거는 evidence로 분리" },
        "consequence": { "type": "string", "description": "안 하면 생기는 일 (돈·시간 기준)" },
        "options": {
          "type": "array",
          "description": "선택지. 만들 수 없으면 빈 배열",
          "items": { "$ref": "#/$defs/option" }
        },
        "recommendation": {
          "type": ["object", "null"],
          "description": "추천 선택지 하나와 이유. 선택지가 없으면 null",
          "properties": {
            "option_id": { "type": "string" },
            "reason": { "type": "string" }
          }
        },
        "contact": {
          "$ref": "#/$defs/contact",
          "description": "이 카드와 관련된 담당 기관 연락처. 없으면 null"
        },
        "user_action": { "$ref": "#/$defs/userAction" },
        "chosen_option": { "type": ["string", "null"], "description": "사용자가 고른 option_id. 아직이면 null" },
        "action_status": { "enum": ["pending", "sent", "done"], "default": "pending", "description": "user_action의 진행 상태. 화면은 결정 → 실행 → 완료 3단계로 보여준다" },
        "action_reply": { "type": ["string", "null"], "description": "사용자가 남긴 결과 메모" },
        "resolved_title": { "type": ["string", "null"], "description": "선택지를 적용해 재분석한 뒤 판정이 바뀌었을 때의 결론 한 줄. 안 바뀌면 null" },
        "verdict_before": { "type": ["string", "null"], "description": "선택 적용 전 판정. 선택 전이거나 안 바뀌면 null" },
        "linked_task_ids": { "type": "array", "items": { "type": "string" }, "description": "이 카드와 같은 일인 체크리스트 항목 id. 연결된 카드가 모두 완료되면 해당 항목이 자동으로 체크된다" },
        "applied_changes": {
          "type": "array",
          "description": "선택을 적용했을 때 바뀐 내용 (가게 정보 before→after, 체크리스트 추가·변경, 판정 변화). 선택 전이면 빈 배열",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "description": "근거가 비어 있으면 verdict는 반드시 \"판단 불가\"",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["option_id", "label", "apply"],
      "properties": {
        "option_id": { "type": "string" },
        "label": { "type": "string" },
        "summary": { "type": "string" },
        "time": {
          "type": "object",
          "description": "basis가 null이면 text는 \"확인 필요\". 근거 없는 기간을 추정해서 쓰지 않는다",
          "properties": {
            "text": { "type": "string" },
            "basis": { "enum": ["rule", "calc", "data", "notice", null] }
          }
        },
        "cost": {
          "type": "object",
          "description": "basis가 null이면 delta_krw는 null, text는 \"확인 필요\". 금액 차이는 계산 도구가 계산한다",
          "properties": {
            "text": { "type": "string" },
            "delta_krw": { "type": ["integer", "null"] },
            "basis": { "enum": ["rule", "calc", "data", "notice", null] }
          }
        },
        "apply": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["update_store", "none"] },
            "payload": { "type": "object" },
            "adds_checklist": { "type": "array", "items": { "type": "string" }, "description": "선택으로 체크리스트에 새로 생기는 할 일 id (예: x-1)" },
            "needs_reanalyze": { "type": "boolean" }
          }
        },
        "remedy": { "type": ["string", "null"], "description": "규칙 묶음의 remedies 값. 허용된 대응 유형 검증용이며 화면에는 보여주지 않는다" }
      }
    },
    "contact": {
      "type": ["object", "null"],
      "description": "담당 기관 연락처. 규칙 묶음 contacts에서 가져오며, 확인하지 못한 번호는 is_example: true",
      "properties": {
        "agency": { "type": "string" },
        "phone": { "type": ["string", "null"] },
        "is_example": { "type": "boolean" },
        "tip": { "type": ["string", "null"], "description": "대체 번호일 때 안내 (예: 관할 구청 건축과로 연결해 달라고 말씀하세요)" }
      }
    },
    "userAction": {
      "type": ["object", "null"],
      "description": "사용자가 직접 해야 하는 일 1개",
      "properties": {
        "type": { "enum": ["send", "sign", "visit", "decide"] },
        "text": { "type": "string" },
        "est_minutes": { "type": "integer" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["data", "law"] },
        "source": { "type": "string", "description": "예: 건축물대장, 식품위생법 시행령 제21조" },
        "value": { "type": "string", "description": "데이터 원값 또는 조문 원문" },
        "url": { "type": "string", "format": "uri", "description": "law.go.kr 링크 등" }
      }
    },
    "document": {
      "type": "object",
      "required": ["doc_id", "name", "links"],
      "description": "체크리스트 항목에 필요한 서류와 받는 곳. 서류를 만들어 주지 않고 어디서 받는지만 안내한다. 링크는 규칙 묶음 sites의 검증된 공식 사이트 첫 화면만 담는다",
      "properties": {
        "doc_id": { "type": "string" },
        "name": { "type": "string" },
        "agency": { "type": "string", "description": "받는 곳 (예: 정부24 · 세움터)" },
        "guide": { "type": "string", "description": "찾는 방법 한두 문장" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "contact": { "$ref": "#/$defs/contact" }
      }
    },
    "scheduleEntry": {
      "type": "object",
      "required": ["d_day", "task"],
      "properties": {
        "d_day": { "type": "string", "pattern": "^D-[0-9]+$" },
        "date": { "type": "string", "format": "date" },
        "task": { "type": "string" },
        "related_item_id": { "type": "string" },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/document" }, "description": "이 일정에 필요한 서류. 받는 곳 안내" }
      }
    }
  }
}
