{
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report_group"
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "is_example": {
      "type": "boolean"
    },
    "example_notice": {
      "type": "string"
    }
  },
  "required": [
    "store_id",
    "run_id",
    "generated_at",
    "summary",
    "groups",
    "disclaimer"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundy.invalid/contracts/report-schema.json",
  "title": "StoreReportResponse",
  "description": "API 명세서 §2·§6 기준 REST 응답. AI 내부 AnalysisResult와 구분한다. 추가 필드 허용 범위는 이 스키마의 검증 규칙이며 팀 리뷰 대상이다.",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "data",
            "law",
            "notice"
          ]
        },
        "source": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "law_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "article": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "from_cache": {
          "type": "boolean"
        },
        "from_mock": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "source"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "agency": {
          "type": "string"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_example": {
          "type": "boolean"
        },
        "tip": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agency",
        "phone",
        "is_example"
      ],
      "additionalProperties": false
    },
    "estimate": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "rule",
            "calc",
            "data",
            "notice",
            null
          ]
        },
        "delta_krw": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "type": "null"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "const": "확인 필요"
              },
              "delta_krw": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "apply": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "update_store",
            "none"
          ]
        },
        "payload": {
          "type": "object"
        },
        "needs_reanalyze": {
          "type": "boolean"
        },
        "adds_checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "user_action": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "send",
            "sign",
            "visit",
            "decide"
          ]
        },
        "text": {
          "type": "string"
        },
        "est_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/estimate"
        },
        "cost": {
          "$ref": "#/$defs/estimate"
        },
        "apply": {
          "$ref": "#/$defs/apply"
        },
        "remedy": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_action"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "option_id",
        "label",
        "apply"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "report_item": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "check_id": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "계약 전",
            "개업 전",
            "운영 중"
          ]
        },
        "title": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "high",
            "low",
            "unknown",
            "ok"
          ]
        },
        "decided_by": {
          "enum": [
            "rule",
            "ai"
          ]
        },
        "reason": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/recommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_action"
            },
            {
              "type": "null"
            }
          ]
        },
        "chosen_option": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_status": {
          "enum": [
            "pending",
            "sent",
            "done"
          ]
        },
        "action_reply": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict_before": {
          "anyOf": [
            {
              "enum": [
                "high",
                "low",
                "unknown",
                "ok"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "linked_task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applied_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "contact": {
          "anyOf": [
            {
              "$ref": "#/$defs/contact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item_id",
        "check_id",
        "title",
        "verdict",
        "decided_by",
        "reason",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "AI 판정의 상한은 low다. 예외: 건물 용도(building_use)·위반건축물(building_violation)은 인용 검증과 규칙표 대조를 통과하면 AI 판정도 high가 될 수 있다 (API 명세서 2장 Verdict).",
          "if": {
            "properties": {
              "decided_by": {
                "const": "ai"
              },
              "check_id": {
                "not": {
                  "enum": [
                    "building_use",
                    "building_violation"
                  ]
                }
              }
            },
            "required": [
              "decided_by",
              "check_id"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "enum": [
                  "low",
                  "unknown",
                  "ok"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "not": {
                  "const": "unknown"
                }
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "ok": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "high",
        "low",
        "unknown",
        "ok"
      ],
      "additionalProperties": false
    },
    "report_group": {
      "type": "object",
      "properties": {
        "stage": {
          "enum": [
            "계약 전",
            "개업 전",
            "운영 중"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/report_item"
          }
        }
      },
      "required": [
        "stage",
        "items"
      ],
      "additionalProperties": false
    },
    "checklist_item": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "category": {
          "enum": [
            "영업 인허가",
            "세무",
            "고용",
            "건물·시설",
            "간판·광고",
            "표시 의무",
            "정책"
          ]
        },
        "group_label": {
          "anyOf": [
            {
              "enum": [
                "계약 전",
                "개업 4주 전",
                "개업 직전",
                "개업 후"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "dday": {
          "type": [
            "integer",
            "null"
          ]
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "agency": {
          "type": [
            "string",
            "null"
          ]
        },
        "contact": {
          "anyOf": [
            {
              "$ref": "#/$defs/contact"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "rule",
            "report",
            "grant"
          ]
        },
        "report_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "done": {
          "type": "boolean"
        },
        "auto_checked": {
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "task",
        "category",
        "source",
        "done",
        "evidence"
      ],
      "additionalProperties": false
    },
    "next_step": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "new",
            "decide",
            "do",
            "task"
          ]
        },
        "title": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        },
        "go": {
          "type": "object",
          "properties": {
            "page": {
              "type": "string"
            },
            "item_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "title",
        "go"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "agency": {
          "type": "string"
        },
        "guide": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "contact": {
          "anyOf": [
            {
              "$ref": "#/$defs/contact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "doc_id",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
