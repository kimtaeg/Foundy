# 복사해서 .env로 만들고 값을 채운다. .env는 절대 커밋하지 않는다.

# 공공데이터포털(data.go.kr) 일반 인증키 (건축HUB, 상가정보, K-Startup, 부동산원에 공용)
DATA_GO_KR_KEY=

# 국가법령정보 open.law.go.kr: 가입 ID의 @ 앞부분
LAW_OC=

# KIPRIS Plus getAdvancedSearch의 ServiceKey (변수명은 backend와 통일)
KIPRIS_API_KEY=
KIPRIS_TRADEMARK_URL=

# 카카오 디벨로퍼스 REST API 키
KAKAO_REST_KEY=

# 서울열린데이터광장 인증키와 확인한 서비스명(예: 상권분석 길단위인구)
SEOUL_KEY=
SEOUL_SERVICE_FLOATING_POP=

# 기업마당 인증키(crtfcKey)
BIZINFO_KEY=

# 시연 주소와 테스트용 상호
DEMO_ADDRESS=서울 성동구 성수동2가 300-1
DEMO_BRAND=모노커피
